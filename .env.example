# Chronos Environment Configuration Template
# Copy this file to .env and configure your local settings

# Chrome DevTools Protocol URL
CHROME_CDP_URL=http://127.0.0.1:9222

# Path to compiled browser agent
AGENT_JS_PATH=agent-js/dist/chronos-agent.js

# Skip automatic Playwright browser binary download
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Default HTTP replay server port
PORT=8085

# Gemini API Key for AI Root-Cause Analysis (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
